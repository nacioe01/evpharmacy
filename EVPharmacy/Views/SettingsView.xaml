<UserControl x:Class="EVPharmacy.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="960" d:DesignHeight="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,24">

                <Border Background="{StaticResource WarningSoftBrush}"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="14,11"
                        Margin="0,0,0,16"
                        Visibility="{Binding IsUnconfirmed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="12.5"
                               Text="These settings still hold the standard defaults and have not been reviewed. Check every value below with your accountant or BIR registration, then press Save."/>
                </Border>

                <Border Style="{StaticResource ErrorBanner}"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <Border Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12,9"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="{StaticResource SuccessBrush}" FontSize="12.5"/>
                </Border>

                <!-- Business details -->
                <Border Style="{StaticResource Card}" Padding="24,22,24,6">
                    <StackPanel>
                        <TextBlock Text="Business details" Style="{StaticResource Text.Subtitle}"/>
                        <TextBlock Text="Printed at the top of every receipt."
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,16"/>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="Store name *" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="120" AutomationProperties.Name="Store name"/>
                            <TextBlock Text="{Binding StoreNameError}" Style="{StaticResource Text.FieldError}"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="Address" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="250" AutomationProperties.Name="Address"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="TIN" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding Tin, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="30" AutomationProperties.Name="TIN"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Contact number" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="60" AutomationProperties.Name="Contact number"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="Permit / accreditation line" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding PermitInfo, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="60" AutomationProperties.Name="Permit information"/>
                            <TextBlock Text="Printed exactly as typed, for example your BIR authority or permit number."
                                       Style="{StaticResource Text.Caption}" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="Receipt footer" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="200" AutomationProperties.Name="Receipt footer"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tax and discounts -->
                <Border Style="{StaticResource Card}" Padding="24,22,24,6" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Tax and discounts" Style="{StaticResource Text.Subtitle}"/>
                        <TextBlock Text="Used to work out VAT and the Senior Citizen / PWD discounts at the POS."
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,16"/>

                        <CheckBox Content="This store is VAT-registered"
                                  IsChecked="{Binding IsVatRegistered}"/>
                        <TextBlock Text="{Binding VatNote}"
                                   Style="{StaticResource Text.Caption}" Margin="30,5,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="VAT rate (%)" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding VatRateText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="6" AutomationProperties.Name="VAT rate"/>
                                <TextBlock Text="{Binding VatError}" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Senior Citizen discount (%)" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding SeniorText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="6" AutomationProperties.Name="Senior Citizen discount"/>
                                <TextBlock Text="{Binding SeniorError}" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Style="{StaticResource FieldGroup}">
                                <TextBlock Text="PWD discount (%)" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding PwdText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="6" AutomationProperties.Name="PWD discount"/>
                                <TextBlock Text="{Binding PwdError}" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource InfoSoftBrush}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="14,11" Margin="0,0,0,18">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource InfoBrush}"
                                       Text="The defaults are 12% VAT and a 20% Senior Citizen and PWD discount on medicines. For these customers the VAT is removed first and the discount is taken on the VAT-exclusive price. A medicine is only treated as VAT-exempt when its own VAT-exempt box is ticked on the Medicines page. Rates and rules can change, so confirm them with your accountant or the BIR."/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,14">
            <Button Content="Save settings"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Right"
                    MinWidth="160"/>
        </Border>
    </Grid>
</UserControl>
