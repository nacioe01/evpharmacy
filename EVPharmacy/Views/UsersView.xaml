<UserControl x:Class="EVPharmacy.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UsersViewModel}"
             d:DesignWidth="960" d:DesignHeight="640">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Accounts are deactivated, never deleted, so the history of who did what is always kept."
                       Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+  Add user"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding AddCommand}"/>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{StaticResource SuccessSoftBrush}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="12,9" Margin="0,0,0,12"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12.5"/>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="*"/>
                <DataGridTemplateColumn Header="ROLE" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:UserRow}">
                            <Border Style="{StaticResource Pill}" Tag="{Binding RoleKind}">
                                <TextBlock Text="{Binding Role}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="STATUS" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:UserRow}">
                            <Border Style="{StaticResource Pill}" Tag="{Binding StatusPill}">
                                <TextBlock Text="{Binding Status}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ADDED" Binding="{Binding Created}" Width="110"/>
                <DataGridTemplateColumn Width="400">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:UserRow}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Reset password" Style="{StaticResource Button.Soft}"
                                        MinHeight="30" Padding="12,0"
                                        Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="{Binding ToggleRoleText}" Style="{StaticResource Button.Ghost}"
                                        MinHeight="30" Padding="10,0" Margin="6,0,0,0"
                                        Command="{Binding DataContext.ToggleRoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="{Binding ToggleActiveText}" Style="{StaticResource Button.Ghost}"
                                        MinHeight="30" Padding="10,0" Margin="2,0,0,0"
                                        Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
