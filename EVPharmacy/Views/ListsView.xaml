<UserControl x:Class="EVPharmacy.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ListsViewModel}"
             d:DesignWidth="960" d:DesignHeight="640">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kind selector + add -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Categories"
                        Command="{Binding SetKindCommand}"
                        CommandParameter="{x:Static vm:ListKind.Categories}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCategories}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Dosage forms"
                        Margin="6,0,0,0"
                        Command="{Binding SetKindCommand}"
                        CommandParameter="{x:Static vm:ListKind.DosageForms}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDosageForms}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Units of measure"
                        Margin="6,0,0,0"
                        Command="{Binding SetKindCommand}"
                        CommandParameter="{x:Static vm:ListKind.Units}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnits}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="{Binding AddText}"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding AddCommand}"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding Hint}"
                   Style="{StaticResource Text.Body}"
                   Margin="2,0,0,16"/>

        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource ErrorBanner}"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{StaticResource SuccessSoftBrush}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="12,9"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SuccessBrush}"
                           FontSize="12.5"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <DataGrid ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="USED BY" Binding="{Binding Usage}" Width="160"/>
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:LookupRow}">
                                <Border Style="{StaticResource Pill}" Tag="{Binding Kind}">
                                    <TextBlock Text="{Binding Status}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:LookupRow}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Rename"
                                            Style="{StaticResource Button.Soft}"
                                            MinHeight="30"
                                            Padding="12,0"
                                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{Binding ToggleActiveText}"
                                            Style="{StaticResource Button.Ghost}"
                                            MinHeight="30"
                                            Padding="12,0"
                                            Margin="6,0,0,0"
                                            Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Nothing here yet."
                       Style="{StaticResource Text.Body}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</UserControl>
