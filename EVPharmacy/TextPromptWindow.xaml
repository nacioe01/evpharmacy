<Window x:Class="EVPharmacy.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <StackPanel Margin="24">
        <TextBlock x:Name="LabelText" Style="{StaticResource Text.FieldLabel}"/>

        <TextBox x:Name="InputBox"/>

        <Border x:Name="ErrorBox"
                Style="{StaticResource ErrorBanner}"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource Button.Secondary}"
                    IsCancel="True"
                    MinWidth="90"/>
            <Button x:Name="AcceptButton" Content="Add"
                    Style="{StaticResource Button.Primary}"
                    IsDefault="True"
                    Click="OnAccept"
                    MinWidth="90"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
