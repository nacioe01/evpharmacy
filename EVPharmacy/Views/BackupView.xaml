<UserControl x:Class="EVPharmacy.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BackupViewModel}"
             d:DesignWidth="1000" d:DesignHeight="680">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary -->
        <Border Style="{StaticResource Card}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Your data" Style="{StaticResource Text.Subtitle}"/>
                    <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding DatabaseInfo}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource Text.Body}" Margin="0,10,0,0"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Text="A backup is made automatically once a day when the app opens (the newest 14 are kept). Copy backups to a USB drive or cloud folder too: a backup on the same computer does not protect against a failed disk."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                    <Button Content="Back up now"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding BackUpNowCommand}"
                            MinWidth="190"/>
                    <Button Content="Open backup folder"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding OpenFolderCommand}"
                            Margin="0,8,0,0"/>
                    <Button Content="Restore from a file…"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding RestoreFromFileCommand}"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{StaticResource SuccessSoftBrush}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="12,9" Margin="0,0,0,12"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                           FontSize="12.5" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,2,0,0">
            <DataGrid ItemsSource="{Binding Backups}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CREATED" Binding="{Binding When}" Width="190"/>
                    <DataGridTemplateColumn Header="TYPE" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:BackupRow}">
                                <Border Style="{StaticResource Pill}" Tag="{Binding KindPill}">
                                    <TextBlock Text="{Binding Kind}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="90"/>
                    <DataGridTextColumn Header="FILE" Binding="{Binding Info.FileName}" Width="*"/>
                    <DataGridTemplateColumn Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:BackupRow}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Restore" Style="{StaticResource Button.Soft}"
                                            MinHeight="30" Padding="12,0"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Save a copy…" Style="{StaticResource Button.Ghost}"
                                            MinHeight="30" Padding="10,0" Margin="6,0,0,0"
                                            Command="{Binding DataContext.SaveCopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No backups yet. Click Back up now to make the first one."
                       Style="{StaticResource Text.Body}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</UserControl>
