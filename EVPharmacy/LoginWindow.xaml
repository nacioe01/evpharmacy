<Window x:Class="EVPharmacy.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVPharmacy - Login"
        Height="620"
        Width="1000"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F6F3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryGreen" Color="#174D38"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2F8059"/>
        <SolidColorBrush x:Key="TextDark" Color="#24352C"/>
        <SolidColorBrush x:Key="TextMuted" Color="#78867D"/>
        <SolidColorBrush x:Key="InputBackground" Color="#F7F9F7"/>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#24352C"/>
            <Setter Property="Background" Value="#F7F9F7"/>
            <Setter Property="BorderBrush" Value="#DCE5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#24352C"/>
            <Setter Property="Background" Value="#F7F9F7"/>
            <Setter Property="BorderBrush" Value="#DCE5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#174D38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#246448"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#A9BDB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="35">
        <Border Background="White"
                CornerRadius="18"
                BorderBrush="#E3EAE4"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="1.05*"/>
                </Grid.ColumnDefinitions>

                <!-- Left branding panel -->
                <Border Grid.Column="0"
                        Background="#174D38"
                        CornerRadius="18"
                        Margin="0">

                    <Grid Margin="38">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="44"
                                    Height="44"
                                    Background="#FFFFFF"
                                    CornerRadius="10">
                                <TextBlock Text="EV"
                                           Foreground="#174D38"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="EVPharmacy"
                                           Foreground="White"
                                           FontSize="21"
                                           FontWeight="Bold"/>
                                <TextBlock Text="PHARMACY MANAGEMENT"
                                           Foreground="#C8DED0"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,20">

                            <TextBlock Text="Manage your&#10;pharmacy with ease."
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       LineHeight="42"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="A simple, organized workspace for your pharmacy operations."
                                       Foreground="#D1E2D7"
                                       FontSize="14"
                                       LineHeight="23"
                                       TextWrapping="Wrap"
                                       Margin="0,18,0,0"/>

                            <Border Background="#245D45"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,28,0,0">
                                <StackPanel>
                                    <TextBlock Text="YOUR PHARMACY. ONE PLACE."
                                               Foreground="#D1E2D7"
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Inventory • Sales • Operations"
                                               Foreground="White"
                                               FontSize="13"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Text="EVPharmacy  |  Secure access"
                                   Foreground="#C8DED0"
                                   FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Login form -->
                <Grid Grid.Column="1"
                      Margin="48,35,48,35">
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Welcome back"
                                   Foreground="#24352C"
                                   FontSize="29"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Sign in to access your pharmacy dashboard."
                                   Foreground="#78867D"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,30"/>

                        <TextBlock Text="Username"
                                   Foreground="#35483C"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource InputStyle}"
                                 ToolTip="Enter your username"/>

                        <TextBlock Text="Password"
                                   Foreground="#35483C"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,8"/>

                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource PasswordStyle}"
                                     ToolTip="Enter your password"/>

                        <TextBlock x:Name="StatusTextBlock"
                                   Foreground="#C0392B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MinHeight="18"
                                   Margin="0,12,0,4"/>

                        <Button x:Name="LoginButton"
                                Content="Sign In"
                                Style="{StaticResource LoginButtonStyle}"
                                Click="LoginButton_Click"
                                IsEnabled="False"
                                Margin="0,8,0,0"/>

                        <TextBlock Text="Authorized personnel only"
                                   Foreground="#8A968D"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,22,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
