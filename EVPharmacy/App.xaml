<Application x:Class="EVPharmacy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             xmlns:views="clr-namespace:EVPharmacy.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Page view model to view mapping used by the main window content host -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MedicinesViewModel}">
                <views:MedicinesView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MedicineFormViewModel}">
                <views:MedicineFormView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
                <views:SuppliersView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SupplierFormViewModel}">
                <views:SupplierFormView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReceiveStockViewModel}">
                <views:ReceiveStockView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AdjustStockViewModel}">
                <views:AdjustStockView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ListsViewModel}">
                <views:ListsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
