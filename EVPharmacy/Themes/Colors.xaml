<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- EVPharmacy light theme: neutral surfaces with a calm green accent. -->

    <!-- Base colours -->
    <Color x:Key="PrimaryColor">#1E7F5C</Color>
    <Color x:Key="PrimaryHoverColor">#186B4D</Color>
    <Color x:Key="PrimaryPressedColor">#135A40</Color>
    <Color x:Key="PrimarySoftColor">#E9F5EF</Color>
    <Color x:Key="PrimarySoftHoverColor">#DCEFE5</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F8F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F9FBFA"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F2F6F4"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E4EAE6"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CDD8D2"/>

    <!-- Brand -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="PrimarySoftHoverBrush" Color="{StaticResource PrimarySoftHoverColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DisabledFillBrush" Color="#B9CCC2"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17211C"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6E66"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8C9891"/>

    <!-- Status -->
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF0EE"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F8CFC9"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B54708"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF6E5"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7F5C"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E9F5EF"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#2563A8"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#EBF3FC"/>

    <!-- Typography -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13.5</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">15</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">26</sys:Double>

    <!-- Shape -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

    <!-- Touch-friendly minimum control height -->
    <sys:Double x:Key="ControlHeight">42</sys:Double>

</ResourceDictionary>
