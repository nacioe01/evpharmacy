<UserControl x:Class="EVPharmacy.Views.SupplierFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SupplierFormViewModel}"
             d:DesignWidth="960" d:DesignHeight="640">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="32,22,32,0">
            <Button Style="{StaticResource Button.Ghost}"
                    Command="{Binding CancelCommand}"
                    Content="←  Back to suppliers"
                    HorizontalAlignment="Left"
                    MinHeight="34"
                    Padding="10,0"/>
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource Text.Title}"
                       Margin="0,8,0,0"/>
            <TextBlock Text="Fields marked * are required."
                       Style="{StaticResource Text.Caption}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,16,32,24">

                <Border Style="{StaticResource ErrorBanner}"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <Border Style="{StaticResource Card}" Padding="24,22,24,6">
                    <StackPanel>
                        <TextBlock Text="Supplier details" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16"/>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="Supplier name *" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="120"
                                     AutomationProperties.Name="Supplier name"/>
                            <TextBlock Text="{Binding NameError}" Style="{StaticResource Text.FieldError}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Contact person" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120"
                                         AutomationProperties.Name="Contact person"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Phone" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="40"
                                         AutomationProperties.Name="Phone"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="Email" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="120"
                                     AutomationProperties.Name="Email"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="Address" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="250"
                                     AutomationProperties.Name="Address"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"/>
                <Button Content="{Binding SaveText}"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding SaveCommand}"
                        MinWidth="150"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
