<UserControl x:Class="EVPharmacy.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SalesHistoryViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== List ===================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Today" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.Today}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Yesterday" Margin="6,0,0,0" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.Yesterday}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsYesterday}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Last 7 days" Margin="6,0,0,0" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.Last7Days}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLast7}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Last 30 days" Margin="6,0,0,0" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.Last30Days}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLast30}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="All" Margin="6,0,0,0" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.All}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAll}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox x:Name="SearchBox" MinHeight="36"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search sales"/>
                    <TextBlock Text="Search receipt no. or customer"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="14" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="13,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <CheckBox Grid.Column="1" Content="Show voided"
                          IsChecked="{Binding IncludeVoided}" Margin="16,0,0,0"/>

                <TextBlock Grid.Column="2" Text="{Binding Summary}"
                           Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,10"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>
                <Border Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12,9" Margin="0,0,0,10"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12.5"/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RECEIPT" Binding="{Binding Receipt}" Width="130"/>
                        <DataGridTextColumn Header="WHEN" Binding="{Binding When}" Width="125"/>
                        <DataGridTextColumn Header="CASHIER" Binding="{Binding Cashier}" Width="*"/>
                        <DataGridTextColumn Header="ITEMS" Binding="{Binding Items}" Width="55"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding Total}" Width="95"/>
                        <DataGridTextColumn Header="PAID BY" Binding="{Binding Payment}" Width="75"/>
                        <DataGridTextColumn Header="DISC." Binding="{Binding Discount}" Width="65"/>
                        <DataGridTemplateColumn Header="STATUS" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:SaleRow}">
                                    <Border Style="{StaticResource Pill}" Tag="{Binding Kind}">
                                        <TextBlock Text="{Binding Status}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No sales found for this period."
                           Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>

        <!-- ===================== Receipt preview ===================== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <FlowDocumentScrollViewer Document="{Binding ReceiptDocument}"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="4"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                >
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource IconBadge}" Width="48" Height="48" CornerRadius="24">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Select a sale" Style="{StaticResource Text.Subtitle}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Its receipt appears here."
                                   Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Padding="16,12"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Void sale"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding VoidCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"
                                Foreground="{StaticResource DangerBrush}"/>
                        <Button Content="Print receipt"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding PrintCommand}"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
