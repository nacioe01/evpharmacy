<Window x:Class="EVPharmacy.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EV Pharmacy - Sign in"
        Height="600"
        Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Brand panel ===================== -->
        <Border Background="{StaticResource PrimarySoftBrush}">
            <Grid Margin="44,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource BrandMark}">
                        <TextBlock Text="EV"
                                   Foreground="{StaticResource OnPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="EV Pharmacy"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Point of Sale"
                                   Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Your pharmacy,&#10;simply organized."
                               FontSize="30"
                               FontWeight="SemiBold"
                               LineHeight="40"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Medicines, stock and sales in one clean, reliable workspace."
                               Style="{StaticResource Text.Body}"
                               FontSize="14"
                               Margin="0,14,0,30"/>

                    <!-- Feature list -->
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="FeatureIcon" TargetType="Border">
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Style>
                            <Style x:Key="FeatureText" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="12,0,0,0"/>
                            </Style>
                        </StackPanel.Resources>

                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource FeatureIcon}">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Text.Icon}" FontSize="14"/>
                            </Border>
                            <TextBlock Text="Batch and expiry tracking" Style="{StaticResource FeatureText}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource FeatureIcon}">
                                <TextBlock Text="&#xE7BF;" Style="{StaticResource Text.Icon}" FontSize="14"/>
                            </Border>
                            <TextBlock Text="Fast, accurate checkout" Style="{StaticResource FeatureText}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource FeatureIcon}">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="14"/>
                            </Border>
                            <TextBlock Text="Secure staff access" Style="{StaticResource FeatureText}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Authorized personnel only"
                           Style="{StaticResource Text.Caption}"/>
            </Grid>
        </Border>

        <!-- ===================== Sign-in form ===================== -->
        <Grid Grid.Column="1">
            <StackPanel Width="340"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Welcome back" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="Sign in with your staff account to continue."
                           Style="{StaticResource Text.Body}"
                           Margin="0,6,0,30"/>

                <TextBlock Text="Username" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox x:Name="UsernameTextBox"
                         MaxLength="36"
                         AutomationProperties.Name="Username"/>

                <TextBlock Text="Password"
                           Style="{StaticResource Text.FieldLabel}"
                           Margin="0,18,0,6"/>
                <PasswordBox x:Name="PasswordInput"
                             AutomationProperties.Name="Password"/>

                <TextBlock x:Name="CapsLockWarning"
                           Text="Caps Lock is on"
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="12"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>

                <Border x:Name="ErrorBanner"
                        Style="{StaticResource ErrorBanner}"
                        Margin="0,16,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorTextBlock" TextWrapping="Wrap"/>
                </Border>

                <Button x:Name="LoginButton"
                        Content="Sign in"
                        Style="{StaticResource Button.Primary}"
                        MinHeight="46"
                        Margin="0,24,0,0"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="LoginButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
