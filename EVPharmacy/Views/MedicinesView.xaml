<UserControl x:Class="EVPharmacy.Views.MedicinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicinesViewModel}"
             d:DesignWidth="960" d:DesignHeight="640">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <!-- ===================== List ===================== -->
        <Grid Margin="32,24,32,24"
              Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by generic name, brand name or barcode"
                         AutomationProperties.Name="Search medicines"/>
                <TextBlock Text="Search name, brand or barcode"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="13,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <CheckBox Grid.Column="1"
                          Content="Show inactive"
                          IsChecked="{Binding ShowInactive}"
                          Margin="18,0,0,0"/>

                <Button Grid.Column="3"
                        Content="+  Add medicine"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding AddCommand}"/>
            </Grid>

            <!-- Messages -->
            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource ErrorBanner}"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <Border Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12,9"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="12.5"/>
                </Border>
            </StackPanel>

            <!-- Table -->
            <Grid Grid.Row="2">
                <DataGrid x:Name="Grid"
                          ItemsSource="{Binding Items}"
                          MouseDoubleClick="OnRowDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GENERIC NAME" Binding="{Binding GenericName}" Width="1.3*"/>
                        <DataGridTextColumn Header="BRAND" Binding="{Binding BrandName}" Width="1.2*"/>
                        <DataGridTextColumn Header="STRENGTH" Binding="{Binding Strength}" Width="Auto"/>
                        <DataGridTextColumn Header="FORM" Binding="{Binding DosageForm}" Width="Auto"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.5*"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding Prescription}" Width="Auto"/>
                        <DataGridTextColumn Header="COST" Binding="{Binding Cost}" Width="Auto"/>
                        <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" Width="Auto"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="Auto"/>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MedicineRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit"
                                                Style="{StaticResource Button.Soft}"
                                                MinHeight="30"
                                                Padding="12,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{Binding ToggleActiveText}"
                                                Style="{StaticResource Button.Ghost}"
                                                MinHeight="30"
                                                Padding="12,0"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding EmptyText}"
                           Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,40,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>

        <!-- ===================== Add / edit form ===================== -->
        <ContentControl Content="{Binding Form}" Focusable="False"/>
    </Grid>
</UserControl>
