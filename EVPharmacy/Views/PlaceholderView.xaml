<UserControl x:Class="EVPharmacy.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlaceholderViewModel}"
             d:DesignWidth="960" d:DesignHeight="640">

    <Grid Margin="32">
        <Border Style="{StaticResource Card}"
                MaxWidth="520"
                Padding="40,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <Border Style="{StaticResource IconBadge}"
                        Width="56" Height="56" CornerRadius="16"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="22"/>
                </Border>

                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource Text.Title}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,8"/>

                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource Text.Body}"
                           TextAlignment="Center"/>

                <Border Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="12"
                        Padding="12,5"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="Planned for"/>
                        <Run Text="{Binding PlannedPhase, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
