    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EVPharmacy.Core\EVPharmacy.Core.csproj" />
    <ProjectReference Include="..\EVPharmacy.Data\EVPharmacy.Data.csproj" />
  </ItemGroup>

</Project>
