<Window x:Class="EVPharmacy.SetupAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EV Pharmacy - First-time setup"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Border Style="{StaticResource Card}"
            Margin="28"
            Padding="36,32">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BrandMark}">
                    <TextBlock Text="EV"
                               Foreground="{StaticResource OnPrimaryBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock Text="EV Pharmacy"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="First-time setup" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Create the administrator account"
                       Style="{StaticResource Text.Title}"
                       Margin="0,26,0,6"/>
            <TextBlock Text="This account manages staff, settings and backups. Keep its password private."
                       Style="{StaticResource Text.Body}"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Username" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox x:Name="UsernameTextBox"
                     MaxLength="36"
                     AutomationProperties.Name="Username"/>

            <TextBlock Text="Password"
                       Style="{StaticResource Text.FieldLabel}"
                       Margin="0,18,0,6"/>
            <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password"/>
            <TextBlock x:Name="PasswordHintTextBlock"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,6,0,0"/>

            <TextBlock Text="Confirm password"
                       Style="{StaticResource Text.FieldLabel}"
                       Margin="0,16,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordInput" AutomationProperties.Name="Confirm password"/>

            <Border x:Name="ErrorBanner"
                    Style="{StaticResource ErrorBanner}"
                    Margin="0,18,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorTextBlock" TextWrapping="Wrap"/>
            </Border>

            <Button x:Name="CreateButton"
                    Content="Create administrator"
                    Style="{StaticResource Button.Primary}"
                    MinHeight="46"
                    Margin="0,24,0,0"
                    IsDefault="True"
                    Click="CreateAdminButton_Click"/>
        </StackPanel>
    </Border>
</Window>
