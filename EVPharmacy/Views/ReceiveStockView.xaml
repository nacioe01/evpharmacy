<UserControl x:Class="EVPharmacy.Views.ReceiveStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReceiveStockViewModel}"
             d:DesignWidth="1000" d:DesignHeight="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="SupplierNameTemplate">
            <TextBlock Text="{Binding Name}"/>
        </DataTemplate>

        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="32,22,32,0">
            <Button Style="{StaticResource Button.Ghost}"
                    Command="{Binding CancelCommand}"
                    Content="←  Back to inventory"
                    HorizontalAlignment="Left"
                    MinHeight="34"
                    Padding="10,0"/>
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource Text.Title}"
                       Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Subtitle}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,16,32,24">

                <Border Style="{StaticResource ErrorBanner}"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <!-- ===== Details ===== -->
                <Border Style="{StaticResource Card}" Padding="24,22,24,6">
                    <StackPanel>
                        <TextBlock Text="Details" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,14"/>

                        <CheckBox Content="This is opening stock already on my shelves (not from a supplier delivery)"
                                  IsChecked="{Binding IsOpeningBalance}"
                                  Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource FieldGroup}"
                                        Visibility="{Binding ShowSupplier, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Supplier *" Style="{StaticResource Text.FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Suppliers}"
                                          ItemTemplate="{StaticResource SupplierNameTemplate}"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SupplierId, Mode=TwoWay}"
                                          AutomationProperties.Name="Supplier"/>
                                <TextBlock Text="{Binding SupplierError}" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Invoice / delivery receipt no." Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="60"
                                         AutomationProperties.Name="Invoice number"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Date received *" Style="{StaticResource Text.FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding ReceivedDate, Mode=TwoWay}"
                                            DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                            AutomationProperties.Name="Date received"/>
                                <TextBlock Text="{Binding DateError}" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Notes" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="300"
                                         AutomationProperties.Name="Notes"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Items ===== -->
                <Border Style="{StaticResource Card}" Padding="24,22,24,22" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Items received" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,14"/>

                        <!-- Medicine finder -->
                        <Grid>
                            <TextBox x:Name="FindBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Find medicine to add">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Scan a barcode or type a medicine name to add it"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="14"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="13,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=FindBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Margin="0,6,0,0"
                                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MedicineRow}">
                                        <Button Style="{StaticResource Button.Ghost}"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="14,8"
                                                Command="{Binding DataContext.AddMedicineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GenericName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding BrandName}" Margin="8,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontWeight="Normal"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" FontWeight="Normal"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding Strength, Mode=OneWay}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding DosageForm, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="No active medicine matches that. Add it on the Medicines page first."
                                   Style="{StaticResource Text.Caption}"
                                   Margin="2,8,0,0"
                                   Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Empty hint -->
                        <Border Background="{StaticResource SurfaceMutedBrush}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="16"
                                Margin="0,16,0,0"
                                Visibility="{Binding HasNoLines, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="No items yet. Search above to add the medicines in this delivery."
                                       Style="{StaticResource Text.Body}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Lines -->
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReceiveLineViewModel}">
                                    <Border Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            Padding="16,14"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Remove"
                                                        Style="{StaticResource Button.Ghost}"
                                                        MinHeight="30" Padding="10,0"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="Batch / lot no. *" Style="{StaticResource Text.FieldLabel}"/>
                                                    <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="50"
                                                             AutomationProperties.Name="Batch number"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Expiry date *" Style="{StaticResource Text.FieldLabel}"/>
                                                    <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay}"
                                                                DisplayDateStart="{x:Static sys:DateTime.Today}"
                                                                AutomationProperties.Name="Expiry date"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Style="{StaticResource Text.FieldLabel}">
                                                        <Run Text="Quantity ("/><Run Text="{Binding Unit, Mode=OneWay}"/><Run Text=") *"/>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="7"
                                                             AutomationProperties.Name="Quantity"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="Unit cost (₱) *" Style="{StaticResource Text.FieldLabel}"/>
                                                    <TextBox Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="14"
                                                             AutomationProperties.Name="Unit cost"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding Error}" Style="{StaticResource Text.FieldError}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Content="Also update each medicine's purchase cost to the unit cost entered above"
                                  IsChecked="{Binding UpdateCosts}"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer actions -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding TotalText}"
                           Style="{StaticResource Text.Body}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding CancelCommand}"
                            MinWidth="100"/>
                    <Button Content="{Binding SaveText}"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveCommand}"
                            MinWidth="160"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
