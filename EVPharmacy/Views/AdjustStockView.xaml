<UserControl x:Class="EVPharmacy.Views.AdjustStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdjustStockViewModel}"
             d:DesignWidth="960" d:DesignHeight="700">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="LabelTemplate">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>

        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="32,22,32,0">
            <Button Style="{StaticResource Button.Ghost}"
                    Command="{Binding CancelCommand}"
                    Content="←  Back to inventory"
                    HorizontalAlignment="Left"
                    MinHeight="34"
                    Padding="10,0"/>
            <TextBlock Text="Adjust stock"
                       Style="{StaticResource Text.Title}"
                       Margin="0,8,0,0"/>
            <TextBlock Text="Correct the quantity of one batch. Every adjustment is recorded in the movement history."
                       Style="{StaticResource Text.Caption}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,16,32,24">

                <Border Style="{StaticResource ErrorBanner}"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <!-- Batch being adjusted -->
                <Border Style="{StaticResource Card}" Padding="24,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding MedicineName}" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock Text="{Binding BatchSummary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Pill}" Tag="good" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentText}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="24,22,24,6" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Adjustment" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Reason *" Style="{StaticResource Text.FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Reasons}"
                                          ItemTemplate="{StaticResource LabelTemplate}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Reason, Mode=TwoWay}"
                                          AutomationProperties.Name="Reason"/>
                                <TextBlock Text="{Binding ReasonError}" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FieldGroup}">
                                <TextBlock Text="Action" Style="{StaticResource Text.FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Directions}"
                                          ItemTemplate="{StaticResource LabelTemplate}"
                                          SelectedValuePath="IsIncrease"
                                          SelectedValue="{Binding IsIncrease, Mode=TwoWay}"
                                          IsEnabled="{Binding AllowsIncrease}"
                                          AutomationProperties.Name="Action"/>
                                <TextBlock Text="Only count corrections and &quot;Other&quot; can add stock."
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Style="{StaticResource FieldGroup}" Width="240" HorizontalAlignment="Left">
                            <TextBlock Text="Quantity *" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="7"
                                     AutomationProperties.Name="Quantity"/>
                            <TextBlock Text="{Binding QuantityError}" Style="{StaticResource Text.FieldError}"/>
                            <TextBlock Text="{Binding PreviewText}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="{Binding NoteLabel}" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="300"
                                     AutomationProperties.Name="Note"/>
                            <TextBlock Text="{Binding NoteError}" Style="{StaticResource Text.FieldError}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"/>
                <Button Content="Save adjustment"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding SaveCommand}"
                        MinWidth="160"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
