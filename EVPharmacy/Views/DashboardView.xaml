<UserControl x:Class="EVPharmacy.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignWidth="960" d:DesignHeight="640">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- Greeting -->
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="{Binding TodayText}"
                       Style="{StaticResource Text.Body}"
                       Margin="0,6,0,24"/>

            <!-- Key metrics -->
            <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,-14,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DashboardMetric}">
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Value}"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,8,0,4"/>
                                    <TextBlock Text="{Binding Caption}"
                                               Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource IconBadge}"
                                        Width="36" Height="36"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Glyph}"
                                               Style="{StaticResource Text.Icon}"
                                               FontSize="15"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Quick actions -->
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Quick actions" Style="{StaticResource Text.Subtitle}"/>
                        <TextBlock Text="Jump straight into common tasks."
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,18"/>

                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding NewSaleCommand}"
                                MinHeight="48"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BF;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0"/>
                                <TextBlock Text="New sale" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding ReceiveStockCommand}"
                                MinHeight="48"
                                Margin="0,10,0,0"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Text.Icon}"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="Receive stock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding AddMedicineCommand}"
                                MinHeight="48"
                                Margin="0,10,0,0"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="Add medicine" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Alerts -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Alerts" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock Text="Low-stock and expiration warnings."
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,24">
                            <Border Style="{StaticResource IconBadge}" Width="48" Height="48" CornerRadius="24">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="18"/>
                            </Border>
                            <TextBlock Text="All clear"
                                       Style="{StaticResource Text.Subtitle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"/>
                            <TextBlock Text="Alerts will appear here once medicines and stock batches are recorded."
                                       Style="{StaticResource Text.Caption}"
                                       TextAlignment="Center"
                                       MaxWidth="300"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
