<Window x:Class="EVPharmacy.SetupAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVPharmacy - Initial Admin Setup"
        Height="420"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="EVPharmacy"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Create your administrator account"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Username"/>
            <TextBox x:Name="UsernameTextBox"
                     Height="24"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordInput"
                         Height="24"
                         Margin="0,5,0,15"/>

            <TextBlock Text="Confirm Password"/>
            <PasswordBox x:Name="ConfirmPasswordInput"
                         Height="24"
                         Margin="0,5,0,20"/>

            <Button Content="Create Admin Account"
                    Height="38"
                    Click="CreateAdminButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
