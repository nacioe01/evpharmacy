<Window x:Class="EVPharmacy.UserDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <StackPanel Margin="26,24,26,24">
        <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Subtitle}"/>
        <TextBlock x:Name="SubText" Style="{StaticResource Text.Caption}" Margin="0,4,0,18"/>

        <StackPanel x:Name="UsernamePanel" Margin="0,0,0,14">
            <TextBlock Text="Username" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox x:Name="UsernameBox" MaxLength="36" AutomationProperties.Name="Username"/>
        </StackPanel>

        <TextBlock x:Name="PasswordLabel" Text="Password" Style="{StaticResource Text.FieldLabel}"/>
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Password"/>
        <TextBlock x:Name="HintText" Style="{StaticResource Text.Caption}" Margin="0,5,0,14"/>

        <TextBlock Text="Confirm password" Style="{StaticResource Text.FieldLabel}"/>
        <PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="Confirm password"/>

        <CheckBox x:Name="AdminCheck"
                  Content="Administrator (can manage users, settings and backups)"
                  Margin="0,16,0,0"/>

        <Border x:Name="ErrorBox"
                Style="{StaticResource ErrorBanner}"
                Margin="0,14,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True" MinWidth="90"/>
            <Button x:Name="AcceptButton" Style="{StaticResource Button.Primary}"
                    IsDefault="True" Click="OnAccept" MinWidth="120" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
