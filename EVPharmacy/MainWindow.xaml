<Window x:Class="EVPharmacy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="EV Pharmacy"
        Height="780"
        Width="1280"
        MinHeight="640"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="22,0,0,0">
                    <Border Style="{StaticResource BrandMark}">
                        <TextBlock Text="EV"
                                   Foreground="{StaticResource OnPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="EV Pharmacy"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Point of Sale"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1"
                         Style="{StaticResource NavListBox}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Margin="14,8,14,0">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           Style="{StaticResource Text.Icon}"
                                           Width="22"
                                           FontSize="15"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Signed-in user -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="36" Height="36"
                                CornerRadius="18"
                                Background="{StaticResource PrimarySoftBrush}">
                            <TextBlock Text="{Binding UserInitial}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,6,0">
                            <TextBlock Text="{Binding Username}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UserRole}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding LogoutCommand}"
                                ToolTip="Log out"
                                AutomationProperties.Name="Log out"
                                MinHeight="40"
                                Width="40"
                                Padding="0">
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Text.Icon}" FontSize="15"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Main area ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPage.Title}"
                                   Style="{StaticResource Text.Title}"/>
                        <TextBlock Text="{Binding CurrentPage.Subtitle}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content (view chosen by DataTemplates in App.xaml) -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Focusable="False"/>
        </Grid>
    </Grid>
</Window>
