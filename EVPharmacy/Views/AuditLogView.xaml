<UserControl x:Class="EVPharmacy.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AuditLogViewModel}"
             d:DesignWidth="1000" d:DesignHeight="680">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Today" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.Today}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Last 7 days" Margin="6,0,0,0" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.Last7Days}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLast7}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Last 30 days" Margin="6,0,0,0" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.Last30Days}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLast30}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="All" Margin="6,0,0,0" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:HistoryRange.All}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAll}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Grid Grid.Column="2">
                <TextBox x:Name="SearchBox" MinHeight="36"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search audit log"/>
                <TextBlock Text="Search user, action or description"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="13,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" Margin="0,0,0,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="WHEN" Binding="{Binding When}" Width="180"/>
                    <DataGridTextColumn Header="USER" Binding="{Binding User}" Width="110"/>
                    <DataGridTemplateColumn Header="ACTION" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:AuditRow}">
                                <Border Style="{StaticResource Pill}" Tag="{Binding Kind}">
                                    <TextBlock Text="{Binding Action}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="WHAT HAPPENED" Binding="{Binding Summary}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Margin="0,10,0,0"
                    Style="{StaticResource Card}" Padding="16,12"
                    Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Details" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBlock Text="{Binding Selected.Details}"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Nothing recorded for this period."
                       Style="{StaticResource Text.Body}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Footer}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0"/>
    </Grid>
</UserControl>
