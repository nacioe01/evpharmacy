<UserControl x:Class="EVPharmacy.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EVPharmacy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel}"
             d:DesignWidth="1000" d:DesignHeight="680">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Segmented mode button: filled when it is the current mode -->
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style x:Key="StatTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===================== Main ===================== -->
        <Grid Margin="32,24,32,24"
              Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Action bar -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Stock is tracked per batch, so the oldest expiry is always sold first."
                           Style="{StaticResource Text.Body}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Opening balance"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding OpeningBalanceCommand}"
                        ToolTip="Enter stock that is already on your shelves"/>
                <Button Grid.Column="2"
                        Content="+  Receive stock"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding ReceiveCommand}"
                        Margin="10,0,0,0"/>
            </Grid>

            <!-- Alert cards -->
            <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,-12,16">
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Low or out of stock" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Expiring within 90 days" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding ExpiringCount}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="With expired stock" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding ExpiredCount}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Mode + search -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Stock levels"
                            Command="{Binding SetModeCommand}"
                            CommandParameter="{x:Static vm:InventoryMode.Stock}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStockMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Batches and expiry"
                            Margin="6,0,0,0"
                            Command="{Binding SetModeCommand}"
                            CommandParameter="{x:Static vm:InventoryMode.Batches}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Movement history"
                            Margin="6,0,0,0"
                            Command="{Binding SetModeCommand}"
                            CommandParameter="{x:Static vm:InventoryMode.Movements}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovementMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchBox"
                             MinHeight="36"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search inventory"/>
                    <TextBlock Text="Search medicine or batch"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="14"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="13,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <CheckBox Grid.Column="3"
                          Content="Show used-up batches"
                          IsChecked="{Binding ShowEmptyBatches}"
                          Margin="18,0,0,0"
                          Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <!-- Messages -->
            <StackPanel Grid.Row="3">
                <Border Style="{StaticResource ErrorBanner}"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <Border Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12,9"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="12.5"/>
                </Border>
            </StackPanel>

            <!-- Tables -->
            <Grid Grid.Row="4">

                <!-- Stock levels -->
                <DataGrid ItemsSource="{Binding StockRows}"
                          Visibility="{Binding IsStockMode, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="MEDICINE" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:StockRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Medicine}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="{Binding Brand, Mode=OneWay}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding Strength, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="IN STOCK" Binding="{Binding OnHand}" Width="105"/>
                        <DataGridTextColumn Header="REORDER" Binding="{Binding ReorderLevel}" Width="80"/>
                        <DataGridTextColumn Header="EXPIRING" Binding="{Binding ExpiringSoon}" Width="80"/>
                        <DataGridTextColumn Header="EXPIRED" Binding="{Binding Expired}" Width="75"/>
                        <DataGridTextColumn Header="ON HOLD" Binding="{Binding Held}" Width="80"/>
                        <DataGridTextColumn Header="NEXT EXPIRY" Binding="{Binding NextExpiry}" Width="110"/>
                        <DataGridTemplateColumn Header="STATUS" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:StockRow}">
                                    <Border Style="{StaticResource Pill}" Tag="{Binding Kind}">
                                        <TextBlock Text="{Binding Status}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Batches -->
                <DataGrid ItemsSource="{Binding BatchRows}"
                          Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="MEDICINE" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:BatchRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Medicine}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="BATCH / LOT" Binding="{Binding BatchNumber}" Width="100"/>
                        <DataGridTemplateColumn Header="EXPIRY" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:BatchRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Expiry}"/>
                                        <TextBlock Text="{Binding ExpiryDetail}" Style="{StaticResource Text.Caption}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="LEFT / RECEIVED" Binding="{Binding Quantity}" Width="115"/>
                        <DataGridTextColumn Header="UNIT COST" Binding="{Binding UnitCost}" Width="85"/>
                        <DataGridTemplateColumn Header="STATUS" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:BatchRow}">
                                    <Border Style="{StaticResource Pill}" Tag="{Binding Kind}" ToolTip="{Binding Note}">
                                        <TextBlock Text="{Binding Status}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="205">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:BatchRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Adjust"
                                                Style="{StaticResource Button.Soft}"
                                                MinHeight="30" Padding="10,0"
                                                Margin="0,0,4,0"
                                                Visibility="{Binding CanAdjust, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.AdjustCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Hold"
                                                Style="{StaticResource Button.Ghost}"
                                                MinHeight="30" Padding="10,0"
                                                Visibility="{Binding CanHold, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.HoldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Recall"
                                                Style="{StaticResource Button.Ghost}"
                                                MinHeight="30" Padding="10,0"
                                                Visibility="{Binding CanRecall, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RecallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Release"
                                                Style="{StaticResource Button.Soft}"
                                                MinHeight="30" Padding="10,0"
                                                Visibility="{Binding CanRelease, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.ReleaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Movements -->
                <DataGrid ItemsSource="{Binding MovementRows}"
                          Visibility="{Binding IsMovementMode, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="WHEN" Binding="{Binding When}" Width="160"/>
                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding Medicine}" Width="1.4*"/>
                        <DataGridTextColumn Header="BATCH / LOT" Binding="{Binding BatchNumber}" Width="100"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="170"/>
                        <DataGridTemplateColumn Header="CHANGE" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MovementRow}">
                                    <Border Style="{StaticResource Pill}" Tag="{Binding Kind}">
                                        <TextBlock Text="{Binding Change}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="BALANCE" Binding="{Binding Balance}" Width="85"/>
                        <DataGridTextColumn Header="BY" Binding="{Binding By}" Width="90"/>
                        <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding EmptyText}"
                           Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,40,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>

        <!-- ===================== Receive form ===================== -->
        <ContentControl Content="{Binding Form}" Focusable="False"/>
    </Grid>
</UserControl>
